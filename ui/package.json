{
  "name": "recovery-wizard-ui",
  "private": true,
  "version": "0.3.0",
  "description": "Recovery Wizard UI \u2014 Tauri 2 + React 19 + TypeScript (mock-connector driven, clean-room re-implementation)",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "tauri": "tauri",
    "icons": "tauri icon src-tauri/app-icon.png",
    "arch:lint": "node scripts/arch-lint.mjs",
    "knip": "knip",
    "jscpd": "jscpd src --min-tokens 70 --reporters consoleFull --ignore \"src/theme/adopted/**\"",
    "bundle:check": "node scripts/bundle-check.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-virtual": "3.14.22",
    "@tauri-apps/api": "2.12.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.5.6",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.4",
    "react-router": "7.18.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jscpd": "5.4.2",
    "jsdom": "30.1.3",
    "knip": "6.42.1",
    "oxc-transform-react": "0.155.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
