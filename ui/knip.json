{
  "$schema": "https://unpkg.com/knip@6.42.1/schema.json",
  "entry": ["tests/**/*.test.{ts,tsx}"],
  "project": [
    "src/**/*.{ts,tsx,css}",
    "tests/**/*.{ts,tsx}",
    "e2e/**/*.ts",
    "scripts/**/*.mjs"
  ],
  "ignoreDependencies": [],
  "ignoreExportsUsedInFile": true,
  "include": [
    "files",
    "dependencies",
    "unlisted",
    "binaries",
    "unresolved",
    "exports",
    "types",
    "duplicates"
  ]
}
