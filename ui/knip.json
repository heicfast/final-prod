{
  "$schema": "https://unpkg.com/knip@6.42.1/schema.json",
  "entry": ["src/main.tsx"],
  "project": [
    "src/**/*.{ts,tsx}",
    "tests/**/*.ts",
    "e2e/**/*.ts",
    "scripts/**/*.mjs",
    "vite.config.ts",
    "playwright.config.ts"
  ],
  "ignore": ["src/workers/hex.worker.ts", "src/i18n/**"],
  "ignoreDependencies": ["@tauri-apps/api"],
  "include": [
    "files",
    "dependencies",
    "unlisted",
    "binaries",
    "unresolved",
    "exports",
    "types",
    "duplicates"
  ]
}
