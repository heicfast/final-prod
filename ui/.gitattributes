# Normalize all text files to LF in the working tree on every platform.
# GitHub's Windows runners default to core.autocrlf=true, which rewrites the
# checkout to CRLF and trips Prettier's endOfLine=lf check (121 files at once).
* text=auto eol=lf

# Windows scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries — never normalize
*.png binary
*.ico binary
*.icns binary
*.bmp binary
*.exe binary
*.lib binary
*.dll binary
*.pdb binary
