{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "linux-gcc",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CR_BUILD_APP": "OFF",
        "CR_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "linux-release",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "win-x64-debug",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "win-x64-release",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-ubsan",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CR_BUILD_APP": "OFF",
        "CR_ENABLE_ASAN": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-sanitize-recover=undefined -g -fPIE -DCR_SANITIZER_LANE",
        "CMAKE_C_FLAGS": "-fsanitize=undefined -fno-sanitize-recover=undefined -g -fPIE",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined -pie",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "win-x64-debug",
      "configurePreset": "win-x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "win-x64-release",
      "configurePreset": "win-x64-release",
      "configuration": "Release"
    },
    {
      "name": "linux-ubsan",
      "configurePreset": "linux-ubsan"
    }
  ],
  "testPresets": [
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "win-x64-release",
      "configurePreset": "win-x64-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-ubsan",
      "configurePreset": "linux-ubsan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
